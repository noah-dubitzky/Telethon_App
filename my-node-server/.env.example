NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=messaging_personal

# Generate a random value of at least 32 characters. Never commit the real value.
SESSION_SECRET=replace-with-a-long-random-secret

# Browser-based Telegram authentication. Generate both secrets independently.
TELEGRAM_AUTH_SERVICE_URL=http://127.0.0.1:8765
TELEGRAM_AUTH_INTERNAL_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_SESSION_ENCRYPTION_KEY=replace-with-32-random-bytes-encoded-as-base64
TELEGRAM_SESSION_KEY_VERSION=v1

# These two are also required by telegram_auth_service.py. Keep the API hash server-side.
TELEGRAM_API_ID=your-telegram-application-id
TELEGRAM_API_HASH=your-telegram-application-hash
TELEGRAM_AUTH_HOST=127.0.0.1
TELEGRAM_AUTH_PORT=8765
